# Копируется на мини-ПК в /opt/pocketbase/.env и получает chmod 600.
# Пароль в git не пишется. Белый IP сюда не кладётся.
# Символ $ в значениях пишите как $$. Docker Compose иначе считает его переменной и стирает.
PB_PUBLIC_URL=https://pb.booking.vallome.ru
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
# Адрес кабинета, куда ведёт кнопка подтверждения почты.
# localhost, а не 127.0.0.1: Vite по умолчанию слушает localhost,
# а на этой машине это только IPv6 ::1 — IPv4 127.0.0.1 отклоняет соединение.
CABINET_URL=http://localhost:5173
# Токен бота из BotFather (вид 123456:AA...). Не OIDC Client Secret.
# Хук берёт из него только id бота как аудиторию id_token и никуда его не отправляет.
TELEGRAM_BOT_TOKEN=
# Файлы пишутся на диск, контейнер s3-sync переносит их в S3, хук files_s3_fallback читает оттуда.
# Бакет должен быть публичным на чтение. Ключи в git не пишутся.
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_REGION=ru1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес бакета без слэша в конце, например https://s3.ru1.storage.beget.cloud/<бакет>
S3_PUBLIC_BASE_URL=
# Как часто s3-sync пытается перенести файлы, секунды.
S3_SYNC_INTERVAL=300
